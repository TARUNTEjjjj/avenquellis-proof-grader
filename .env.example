# Example names only. Enter actual secrets in your local ignored .env or secret manager.
# Node 20.6+: node --env-file=.env src/server.js
HOST=127.0.0.1
PORT=4175
ALLOWED_ORIGIN=http://localhost:4173
# Base URL ends at /v1; the service appends /chat/completions.
EVALUATOR_BASE_URL=https://api.openai.com/v1
# Choose a model explicitly that supports strict JSON schema Chat Completions.
EVALUATOR_MODEL=
EVALUATOR_API_KEY=
EVALUATOR_TIMEOUT_MS=25000
EVALUATOR_MAX_TOKENS=4000
EVALUATOR_TOKEN_PARAMETER=max_completion_tokens
# Required for any public deployment; keep server-side, never in static website JS.
EVALUATOR_ACCESS_TOKEN=
